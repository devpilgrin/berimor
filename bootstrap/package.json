{
  "name": "berimor",
  "version": "0.8.1",
  "description": "Bootstrap-установщик Berimor: определение платформы, скачивание и верификация платформенного артефакта, оркестрация само-обновления.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
